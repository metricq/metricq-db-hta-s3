{
  "server": "amqp://admin:admin@localhost/",
  "token": "db-hta-go",
  "listen": "127.0.0.1:9090",
  "prefetch": 16,
  "s3": {
    "bucket": "metricq",
    "prefix": "db-hta-go",
    "endpoint": "http://localhost:9000",
    "region": "us-east-1",
    "path_style": true
  },
  "engine": {
    "wal_directory": "./wal",
